{
  "cases": [
    {
      "name": "invalid_request",
      "response": {
        "http_status": 400,
        "body": {
          "code": "missing_images",
          "message": "Missing image_urls parameter.",
          "data": {
            "status": 400
          }
        }
      },
      "expected": {
        "plugin_error_code": "provider_invalid_request",
        "retry": false
      }
    },
    {
      "name": "auth_rejected",
      "response": {
        "http_status": 403,
        "body": {
          "code": "auth_failed",
          "message": "The API key is invalid or disabled.",
          "data": {
            "status": 403
          }
        }
      },
      "expected": {
        "plugin_error_code": "provider_auth_rejected",
        "retry": false
      }
    },
    {
      "name": "insufficient_points",
      "response": {
        "http_status": 402,
        "body": {
          "code": "insufficient_points",
          "message": "Insufficient points.",
          "data": {
            "status": 402
          }
        }
      },
      "expected": {
        "plugin_error_code": "provider_insufficient_balance",
        "retry": false
      }
    },
    {
      "name": "upstream_failure",
      "response": {
        "http_status": 502,
        "body": {
          "code": "image_error",
          "message": "The upstream image provider failed.",
          "data": {
            "status": 502
          }
        }
      },
      "expected": {
        "plugin_error_code": "provider_upstream_failure",
        "retry_eligible": true,
        "requires_retry_policy_permission": true,
        "retry_policy": "bounded_exponential_backoff"
      }
    },
    {
      "name": "gateway_unavailable",
      "response": {
        "http_status": 503,
        "body": {
          "code": "server_unavailable",
          "message": "The image generation service is not configured.",
          "data": {
            "status": 503
          }
        }
      },
      "expected": {
        "plugin_error_code": "provider_unavailable",
        "retry_eligible": true,
        "requires_retry_policy_permission": true,
        "retry_policy": "bounded_exponential_backoff"
      }
    }
  ]
}
