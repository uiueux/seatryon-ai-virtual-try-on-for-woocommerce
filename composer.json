{
    "name": "sea-tryon/sea-tryon",
    "description": "AI-powered virtual try-on and product placement previews for WooCommerce.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "php-stubs/woocommerce-stubs": "^10.9",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.13",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "wp-coding-standards/wpcs": "^3.2"
    },
    "autoload": {
        "psr-4": {
            "SeaTryOn\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SeaTryOn\\Tests\\": "tests/php/"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "test": "phpunit",
        "test:runtime": [
            "@php tests/php/runtime-smoke.php missing",
            "@php tests/php/runtime-smoke.php old",
            "@php tests/php/runtime-smoke.php supported"
        ],
        "check": [
            "@lint",
            "@phpstan",
            "@test",
            "@test:runtime"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "7.4.16"
        },
        "sort-packages": true
    }
}
